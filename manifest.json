{
  "manifest_version": 3,
  "name": "HWC Dashboard Next",
  "short_name": "HWC Next",
  "description": "Een persoonlijke startpagina voor HWC: links, taken, deadlines, notities en focus.",
  "version": "2.0.0",
  "minimum_chrome_version": "100",
  "chrome_url_overrides": { "newtab": "index.html" },
  "action": { "default_title": "HWC Dashboard openen", "default_popup": "popup.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
