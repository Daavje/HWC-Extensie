{
  "manifest_version": 3,
  "name": "HWC Dashboard Next",
  "short_name": "HWC Next",
  "description": "HWC-dashboard met automatisch Magister-rooster, taken, deadlines, notities en focus.",
  "version": "2.1.0",
  "minimum_chrome_version": "120",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "HWC Dashboard openen",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "permissions"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
